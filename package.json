{
  "name": "trace-agent",
  "version": "0.1.0",
  "description": "留痕 Agent — 全程留痕、可审计的桌面自动化智能体",
  "main": "out/main/index.js",
  "author": "youxi",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node tests/security-test.mjs && node tests/logic-test.mjs && node tests/fs-tool-smoke.mjs && node tests/audit-write-smoke.mjs && node tests/report-style-sync.mjs",
    "test:app": "node tests/guard-smoke.mjs && node tests/audit-encryption-smoke.mjs",
    "test:ui": "electron-vite build && node .impeccable/verify-app.mjs",
    "test:dist": "node tests/packaged-smoke.mjs",
    "check": "npm run typecheck && npm test",
    "dist": "electron-vite build && electron-builder --win",
    "dist:portable": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "puppeteer-core": "^24.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
